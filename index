<script>
(function(){
 const oldUpd = window.upd;
 if (typeof oldUpd === 'function') {
   window.upd = function(){
     oldUpd();
     const lcTxt=(document.getElementById('r-lc')||{}).textContent||'';
     const pbTxt=(document.getElementById('r-pb')||{}).textContent||'—';
     const ai=document.getElementById('ai-insight');
     const lc=parseFloat(lcTxt.replace('×',''));
     if(ai && !Number.isNaN(lc)){
       if(lc>=3) ai.textContent=`The current model looks scalable: LTV/CAC is ${lcTxt}, with projected payback at ${pbTxt}. Validate with more cohort points before increasing budgets aggressively.`;
       else if(lc>=1) ai.textContent=`The model is marginal: LTV/CAC is ${lcTxt} and payback is ${pbTxt}. Improve W4/W8 retention, reduce CAC, or increase ARPPU before scaling.`;
       else ai.textContent=`The model is currently unprofitable: LTV/CAC is ${lcTxt}. Scaling paid acquisition would likely destroy margin unless CAC drops or retention/revenue improves.`;
     }
   };
   window.upd();
 }
})();
</script>
