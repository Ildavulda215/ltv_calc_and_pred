<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LTV Calculator and Prediction</title>

<h2 class="sr-only">LTV calculator — power-law retention model with funnel, ad revenue, cost structure, and confidence bands</h2>
<style>
*{box-sizing:border-box;margin:0;padding:0}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
#ltv{font-family:system-ui,sans-serif;font-size:14px}
.tabs{display:flex;gap:4px;border-bottom:.5px solid var(--color-border-tertiary);padding:0 16px;align-items:center}
.tab{display:flex;align-items:center;gap:6px;padding:10px 14px;border:none;background:transparent;cursor:pointer;font-family:inherit;font-size:14px;color:var(--color-text-secondary);border-bottom:2px solid transparent;margin-bottom:-1px}
.tab.on{color:var(--color-text-primary);border-bottom-color:var(--color-text-primary)}
.bdg{font-size:12px;font-weight:500;padding:3px 10px;border-radius:var(--border-radius-md)}
.bg{background:var(--color-background-success);color:var(--color-text-success)}
.by{background:var(--color-background-warning);color:var(--color-text-warning)}
.br{background:var(--color-background-danger);color:var(--color-text-danger)}
.panel{padding:16px;display:none}
.panel.on{display:block}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.sec{background:var(--color-background-secondary);border-radius:var(--border-radius-lg);padding:14px;margin-bottom:12px}
.sh{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.st{font-size:11px;font-weight:500;color:var(--color-text-tertiary);text-transform:uppercase;letter-spacing:.06em}
.row{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;gap:8px}
.row label{font-size:13px;color:var(--color-text-secondary);flex-shrink:0}
input[type=number]{padding:5px 8px;border:.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);background:var(--color-background-primary);color:var(--color-text-primary);font-size:13px;font-family:inherit;width:100px}
.tog{display:flex;background:var(--color-background-tertiary);border-radius:var(--border-radius-md);padding:2px;gap:2px}
.tog button{padding:4px 12px;border:none;border-radius:6px;cursor:pointer;font-family:inherit;font-size:13px;background:transparent;color:var(--color-text-secondary)}
.tog button.on{background:var(--color-background-primary);color:var(--color-text-primary)}
.pt-hd{display:grid;grid-template-columns:62px 86px 26px;gap:4px;margin-bottom:6px}
.pt-hd span{font-size:11px;color:var(--color-text-tertiary)}
.pt-row{display:grid;grid-template-columns:62px 86px 26px;gap:4px;margin-bottom:5px;align-items:center}
.pt-row input{width:100%}
.delbtn{background:transparent;border:none;color:var(--color-text-tertiary);cursor:pointer;font-size:18px;line-height:1;padding:0}
.addbtn{display:flex;align-items:center;gap:4px;padding:3px 10px;border:.5px solid var(--color-border-secondary);border-radius:var(--border-radius-md);background:transparent;color:var(--color-text-secondary);cursor:pointer;font-size:13px;font-family:inherit}
.fml{margin-top:12px;padding:10px 12px;background:var(--color-background-tertiary);border-radius:var(--border-radius-md);border-left:2px solid var(--color-border-secondary);font-size:12px;line-height:1.8;display:none}
.fml .hi{color:var(--color-text-info);font-weight:500;font-family:var(--font-mono)}
.fml .sm{font-size:11px;color:var(--color-text-tertiary);margin-top:2px}
.mc4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}
.mc{background:var(--color-background-secondary);border-radius:var(--border-radius-md);padding:12px 14px}
.mc .ml{font-size:12px;color:var(--color-text-tertiary);margin-bottom:4px}
.mc .mv{font-size:22px;font-weight:500;color:var(--color-text-primary);line-height:1.2}
.mc .ms{font-size:11px;color:var(--color-text-tertiary);margin-top:3px}
.roi-bx{background:var(--color-background-secondary);border-radius:var(--border-radius-lg);padding:14px 16px;margin-bottom:12px}
.roi-g{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.rl{font-size:12px;color:var(--color-text-tertiary)}
.rv{font-size:22px;font-weight:500}
.rs{font-size:12px;color:var(--color-text-tertiary)}
.cbx{background:var(--color-background-secondary);border-radius:var(--border-radius-lg);padding:14px 16px;margin-bottom:12px}
.ct{font-size:14px;font-weight:500;color:var(--color-text-primary);margin-bottom:2px}
.cs{font-size:12px;color:var(--color-text-tertiary);margin-bottom:10px}
.cg{color:var(--color-text-success)}.cy{color:var(--color-text-warning)}.cr{color:var(--color-text-danger)}.cgr{color:var(--color-text-tertiary)}
.empty{padding:48px;text-align:center;color:var(--color-text-tertiary)}
.fbx{margin-top:6px;padding:8px 10px;background:var(--color-background-tertiary);border-radius:var(--border-radius-md);font-size:13px}
</style>

<style>
